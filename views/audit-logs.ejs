<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audit Logs - JJC Production</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js" defer></script>
</head>
<body>
    <header class="app-header">
        <div class="header-left">
            <a href="/dashboard" class="icon-button" title="Back"><i data-lucide="arrow-left"></i></a>
            <div class="header-title">
                <h1>Audit Logs</h1>
                <span>Action History</span>
            </div>
        </div>
        <div class="header-right">
            <div class="user-tag">
                <% if (user.avatar) { %><img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt=""><% } %>
                <span><%= user.username %></span>
            </div>
            <a href="/auth/logout" class="icon-button logout-button" title="Logout"><i data-lucide="log-out"></i></a>
        </div>
    </header>

    <main style="padding: 24px; max-width: 1200px; margin: 0 auto;">
        <!-- Filter Bar -->
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px; flex-wrap: wrap;">
            <span style="font-size: 11px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; margin-right: 4px;">Filter:</span>
            <% const categories = ['all', 'kick', 'note', 'session', 'override', 'wave', 'evaluation']; %>
            <% categories.forEach(cat => { %>
                <button class="btn btn-secondary filter-btn" data-cat="<%= cat %>" style="min-height: 30px; padding: 0 12px; font-size: 12px; <%= cat === 'all' ? 'border-color: var(--border-focus);' : '' %>">
                    <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
                </button>
            <% }) %>
            <div class="search-box" style="margin-left: auto; width: 240px; margin-bottom: 0;">
                <i data-lucide="search"></i>
                <input type="search" placeholder="Search logs..." id="log-search">
            </div>
        </div>

        <!-- Log Count -->
        <div style="margin-bottom: 12px; font-size: 13px; color: var(--text-muted);">
            Showing <strong id="log-count"><%= logs.length %></strong> entries
        </div>

        <!-- Logs Table -->
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse;" id="audit-table">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border);">
                        <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; width: 140px;">Time</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; width: 90px;">Category</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; width: 120px;">Staff</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: var(--text-dim); text-transform: uppercase;">Action</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 11px; font-weight: 700; color: var(--text-dim); text-transform: uppercase;">Details</th>
                    </tr>
                </thead>
                <tbody id="log-tbody">
                    <% logs.forEach(log => { %>
                        <tr class="log-row" data-cat="<%= log.category %>" style="border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.1s;">
                            <td style="padding: 10px 16px; font-size: 12px; color: var(--text-dim); white-space: nowrap; font-family: monospace;">
                                <%= new Date(log.timestamp).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </td>
                            <td style="padding: 10px 16px;">
                                <% const catColors = { kick: 'negative', note: 'neutral', session: 'positive', override: 'neutral', wave: 'positive', evaluation: 'neutral', system: 'neutral' }; %>
                                <span class="badge badge-<%= catColors[log.category] || 'neutral' %>" style="font-size: 10px;"><%= log.category %></span>
                            </td>
                            <td style="padding: 10px 16px; font-size: 12px; font-weight: 600;"><%= log.staffUsername %></td>
                            <td style="padding: 10px 16px; font-size: 13px; font-weight: 600;"><%= log.action %></td>
                            <td style="padding: 10px 16px; font-size: 12px; color: var(--text-muted); max-width: 380px; word-break: break-word;"><%= log.details %></td>
                        </tr>
                    <% }) %>
                    <% if (!logs.length) { %>
                        <tr><td colspan="5" style="padding: 48px; text-align: center; color: var(--text-dim);">No audit log entries yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) lucide.createIcons();

            const rows = [...document.querySelectorAll('.log-row')];
            const countEl = document.getElementById('log-count');

            function updateVisibility() {
                const activeCategory = document.querySelector('.filter-btn.active')?.dataset.cat || 'all';
                const search = document.getElementById('log-search').value.toLowerCase().trim();
                let visible = 0;
                rows.forEach(row => {
                    const matchCat = activeCategory === 'all' || row.dataset.cat === activeCategory;
                    const matchSearch = !search || row.textContent.toLowerCase().includes(search);
                    const show = matchCat && matchSearch;
                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                countEl.textContent = visible;
            }

            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.filter-btn').forEach(b => b.style.borderColor = '');
                    btn.style.borderColor = 'var(--border-focus)';
                    btn.classList.add('active');
                    document.querySelectorAll('.filter-btn').forEach(b => { if (b !== btn) b.classList.remove('active'); });
                    updateVisibility();
                });
            });

            document.getElementById('log-search').addEventListener('input', updateVisibility);

            document.querySelectorAll('.log-row').forEach(row => {
                row.addEventListener('mouseenter', () => row.style.background = 'rgba(255,255,255,0.02)');
                row.addEventListener('mouseleave', () => row.style.background = '');
            });
        });
    </script>
</body>
</html>
